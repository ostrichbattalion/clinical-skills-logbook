{
  "name": "clinical-skills-logbook-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS serverless backend (Cognito, API Gateway, Lambda, DynamoDB) for the clinical skills logbook",
  "scripts": {
    "catalogue": "tsx scripts/build-catalogue.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "synth": "cdk synth",
    "deploy": "cdk deploy --outputs-file cdk-outputs.json && tsx scripts/write-frontend-config.ts",
    "create-user": "tsx scripts/create-user.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1164.0",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1148.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
